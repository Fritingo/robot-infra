      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(DCGM_FI_DEV_FB_USED{exported_namespace=~\"$namespace\"} * 1048576) or robot_local_gpu_memory_used_bytes{namespace=~\"$namespace\",user=~\"$user\"}",
          "legendFormat": "{{exported_pod}} {{GPU_I_PROFILE}} {{modelName}} VRAM Used",
