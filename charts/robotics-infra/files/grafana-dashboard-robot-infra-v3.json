      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(latency{namespace=~\"$namespace\",user=~\"$user\"} > 0) or avg(latency{namespace=~\"$namespace\",user=~\"$user\"})",
          "legendFormat": "Avg RTT",
