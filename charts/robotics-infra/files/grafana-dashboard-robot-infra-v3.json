    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 14, "lineWidth": 2, "showPoints": "never" },
          "min": 0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 301,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "container_memory_working_set_bytes{namespace=~\"$namespace\",container=\"selkies-desktop\"} or robot_local_memory_used_bytes{namespace=~\"$namespace\",user=~\"$user\"}",
          "legendFormat": "{{user}} {{pod}} Memory Used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "kube_pod_container_resource_limits{namespace=~\"$namespace\",container=\"selkies-desktop\",resource=\"memory\"} or robot_local_memory_limit_bytes{namespace=~\"$namespace\",user=~\"$user\"}",
          "legendFormat": "{{user}} {{pod}} Memory Limit",
          "refId": "B"
        }
      ],
      "title": "容器記憶體使用量（Working Set vs Limit）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 14, "lineWidth": 2, "showPoints": "never" },
