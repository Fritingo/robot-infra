          "legendFormat": "{{user}} /home/ubuntu",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(robot_podman_storage_used_bytes{namespace=~\"$namespace\",user=~\"$user\"} / clamp_min(robot_podman_storage_total_bytes{namespace=~\"$namespace\",user=~\"$user\"}, 1)) * 100",
