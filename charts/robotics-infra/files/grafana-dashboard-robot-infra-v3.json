        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(robot_local_network_transmit_dropped_total{namespace=~\"$namespace\",user=~\"$user\"}[2m]) + rate(robot_local_network_receive_dropped_total{namespace=~\"$namespace\",user=~\"$user\"}[2m])",
          "legendFormat": "{{user}} Local Net Drops/s",
